{
  "name": "relyz-ag/pulse-reporter-craft",
  "description": "Relyz Pulse reporter for Craft CMS projects",
  "type": "craft-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "relyzag\\pulsereporter\\": "src/"
    }
  },
  "extra": {
    "handle": "pulse-reporter",
    "name": "Pulse Reporter",
    "developer": "relyz AG",
    "class": "relyzag\\pulsereporter\\Plugin"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  }
}
